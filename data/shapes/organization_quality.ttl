# SHACL shapes describing what "good" organization data looks like in the
# colleague graph. Checked by orcid_etl/quality_gate.py after the graph is
# built. Organizations that fail get dropped from the output graph and
# reported in orcid-etl-issues.md instead, since the fix lives in each
# colleague's own ORCID record, not in this repo.

@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sdo: <https://schema.org/> .

sdo:OrganizationHasIdentifierShape
    a sh:NodeShape ;
    sh:targetClass sdo:Organization ;
    sh:property [
        sh:path sdo:identifier ;
        sh:minCount 1 ;
        sh:message "Organization has no resolvable institutional identifier (e.g. ROR) attached in ORCID - it won't merge correctly with other records for the same institution." ;
    ] .
